// =============================================================================
// Hostel Management — tenant-scoped (school_id non-null + RLS). Boarding houses,
// their rooms (with rent/fare + custom fields), and student room allocations.
// Hostel fees are billed through the SHARED Fees tables (Invoice/InvoiceLineItem)
// so they collect ALONGSIDE academic fees on one student invoice.
// =============================================================================

model Hostel {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  name         String
  /// BOYS | GIRLS | MIXED
  type         String   @default("MIXED")
  /// Optional warden (a staff User) who maintains this hostel's details.
  wardenId     String?  @db.Uuid
  /// Arbitrary extra details (key→value) — the "custom fields" requirement.
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms HostelRoom[]

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("hostel")
}

model HostelRoom {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  hostelId     String   @db.Uuid
  roomNumber   String
  /// e.g. SINGLE | DOUBLE | DORMITORY
  roomType     String   @default("SHARED")
  capacity     Int      @default(1)
  /// Rent / fare for the room in MINOR units (kobo). Charged once per allocation
  /// when hostel fees are scheduled.
  rentMinor    Int      @default(0)
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostel      Hostel             @relation(fields: [hostelId], references: [id])
  allocations HostelAllocation[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([hostelId, roomNumber])
  @@index([schoolId])
  @@index([schoolId, hostelId])
  @@map("hostel_room")
}

model HostelAllocation {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  roomId      String    @db.Uuid
  studentId   String    @db.Uuid
  /// ACTIVE | VACATED — vacating frees the bed (history retained, never deleted).
  status      String    @default("ACTIVE")
  allocatedAt DateTime  @default(now())
  vacatedAt   DateTime?
  createdAt   DateTime  @default(now())

  room HostelRoom @relation(fields: [roomId], references: [id])

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([roomId, status])
  @@map("hostel_allocation")
}

/// Nightly roll-call / boarding attendance. One row per (hostel, student, date).
model HostelAttendance {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  hostelId  String   @db.Uuid
  studentId String   @db.Uuid
  /// The roll-call date (day granularity).
  date      DateTime @db.Date
  /// PRESENT | ABSENT | EXEAT | SICK | LATE
  status    String   @default("PRESENT")
  note      String?
  takenById String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([hostelId, studentId, date])
  @@index([schoolId])
  @@index([schoolId, hostelId, date])
  @@map("hostel_attendance")
}

/// Exeat / gate-pass: a boarder's approved leave to go out (and return). Maker-
/// checker — a warden/admin approves; the student's guardians are notified.
model HostelExeat {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @db.Uuid
  hostelId         String    @db.Uuid
  studentId        String    @db.Uuid
  reason           String
  destination      String?
  departAt         DateTime
  expectedReturnAt DateTime
  actualReturnAt   DateTime?
  /// REQUESTED | APPROVED | REJECTED | DEPARTED | RETURNED | CANCELLED
  status           String    @default("REQUESTED")
  requestedById    String    @db.Uuid
  decidedById      String?   @db.Uuid
  decidedAt        DateTime?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, hostelId, status])
  @@index([schoolId, studentId])
  @@map("hostel_exeat")
}

/// Hostel maintenance / incident log (broken facility, discipline, health, etc.).
/// Append-first with a status lifecycle; resolution is recorded, rows are kept.
model HostelIncident {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @db.Uuid
  hostelId       String    @db.Uuid
  /// Optional room the incident concerns.
  roomId         String?   @db.Uuid
  /// MAINTENANCE | DISCIPLINE | HEALTH | SECURITY | OTHER
  category       String    @default("MAINTENANCE")
  title          String
  description    String?
  /// OPEN | IN_PROGRESS | RESOLVED
  status         String    @default("OPEN")
  reportedById   String    @db.Uuid
  resolvedById   String?   @db.Uuid
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, hostelId, status])
  @@map("hostel_incident")
}
