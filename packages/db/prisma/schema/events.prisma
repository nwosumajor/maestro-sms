// =============================================================================
// Calendar — school events
// =============================================================================
// Staff create events with an audience (everyone, or staff-only); everyone reads
// the events that apply to them. Tenant-scoped (non-null schoolId), RLS-enforced.
// The web calendar merges these with timetable + fee due dates client-side.
// =============================================================================

enum EventAudience {
  ALL
  STAFF
}

model SchoolEvent {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean       @default(false)
  audience    EventAudience @default(ALL)
  createdById String        @db.Uuid

  /// Recurrence. ONE row describes the whole series — occurrences are EXPANDED
  /// in memory for the requested window, never materialised as rows, so a weekly
  /// assembly costs one row instead of forty.
  /// NONE | DAILY | WEEKLY | MONTHLY
  recurrence      String    @default("NONE")
  /// Last date the series repeats (inclusive). Null = no natural end; reads still
  /// bound it by the requested window, so it can never expand without limit.
  recurrenceUntil DateTime?
  /// WEEKLY only: which weekdays, e.g. ["MON","WED"]. Empty = the start's weekday.
  recurrenceDays  Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, startsAt])
  @@map("school_event")
}
