// =============================================================================
// Parent-teacher meetings — bookable appointment slots
// =============================================================================
// A teacher (or staff) publishes available time slots; a parent books one for
// their child. Tenant-scoped; the slot is claimed atomically (capacity guard).

/// An available appointment slot a teacher opens.
model MeetingSlot {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// The teacher the slot is with (DB FK to user; scalar).
  teacherId String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  /// How many bookings the slot accepts (usually 1).
  capacity  Int      @default(1)
  location  String?
  note      String?
  /// Set false to withdraw an unbooked slot (kept for history if booked).
  active    Boolean  @default(true)

  /// WHO this meeting is for: STUDENT | CLASS | STAGE | SCHOOL, with `audienceRef`
  /// naming the pupil, class or year group (null for SCHOOL).
  ///
  /// The RULE is stored, never the resolved list of guardians. Snapshotting
  /// "the 812 guardians of Senior Secondary" would leave out a pupil who enrols
  /// next week and keep inviting one who has left. It is also why nothing fans
  /// out until a notification is actually sent.
  ///
  /// Existing rows default to SCHOOL, which is exactly what they already were:
  /// visible to every parent who could book.
  audienceKind String  @default("SCHOOL")
  audienceRef  String?

  /// APPOINTMENT | BRIEFING — whether this allocates a scarce thing.
  ///
  /// STORED rather than derived from the audience, because the two are not the
  /// same question. A plain bookable slot has no declared audience and so
  /// defaults to SCHOOL, but it is an APPOINTMENT: one teacher, one half-hour,
  /// capacity genuinely enforced. Deriving from the audience quietly removed the
  /// capacity claim from every ordinary slot, which the e2e caught.
  ///
  /// Only a DECLARED wide audience makes a briefing. Existing rows default to
  /// APPOINTMENT, which is exactly what they are.
  kind         String  @default("APPOINTMENT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Optional VIDEO meeting. `provider` names the platform and `joinUrl` is
  /// server-validated (https + per-provider host allowlist, see @sms/types
  /// meeting-link) so a "Teams" link can never point elsewhere. The link is
  /// only released to attendees inside the server-computed join window.
  provider String?
  joinUrl  String?
  school   School           @relation(fields: [schoolId], references: [id])
  bookings MeetingBooking[]
  invitees MeetingInvitee[]
  cohosts  MeetingCohost[]

  @@index([schoolId])
  @@index([schoolId, teacherId])
  @@index([schoolId, startsAt])
  @@map("meeting_slot")
}

/// A parent's booking of a slot, for one of their children.
model MeetingBooking {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  slotId    String  @db.Uuid
  /// The booking parent + the child it concerns (DB FKs to user; scalar).
  parentId  String  @db.Uuid
  studentId String  @db.Uuid
  /// BOOKED | CANCELLED.
  status    String  @default("BOOKED")
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School      @relation(fields: [schoolId], references: [id])
  slot   MeetingSlot @relation(fields: [slotId], references: [id])

  @@index([schoolId])
  @@index([schoolId, slotId])
  @@index([schoolId, parentId])
  @@map("meeting_booking")
}

/// The hand-picked parents of a SELECTED meeting.
///
/// The one audience with no rule to derive a list from — a chosen set of parents
/// IS its own rule — so it is stored. Every other kind stays derivable and
/// therefore stays current as pupils come and go, which is why this table exists
/// only for this case rather than as a general invitation list.
model MeetingInvitee {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  slotId   String @db.Uuid
  /// The invited parent (DB FK to user; scalar, no Prisma relation).
  parentId String @db.Uuid

  createdAt DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id])
  slot   MeetingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  /// Inviting the same parent twice is a no-op, not two invitations.
  @@unique([slotId, parentId])
  @@index([schoolId])
  @@map("meeting_invitee")
}

/// Additional staff attending a meeting alongside its organiser.
///
/// `MeetingSlot.teacherId` stays the ORGANISER — it decides who may withdraw the
/// slot and whose list it appears in as their own. Co-hosts are people who will
/// be in the room: a form teacher joined by the head of year and the counsellor.
/// Modelling them as a second column on the slot would cap it at two; modelling
/// them by replacing teacherId would lose the "who owns this" answer that three
/// other behaviours already depend on.
model MeetingCohost {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  slotId   String @db.Uuid
  /// The attending staff member (DB FK to user; scalar, no Prisma relation).
  teacherId String @db.Uuid

  createdAt DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id])
  slot   MeetingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  /// Adding the same colleague twice is a no-op, not two seats.
  @@unique([slotId, teacherId])
  @@index([schoolId])
  @@index([schoolId, teacherId])
  @@map("meeting_cohost")
}

/// A parent asking a teacher for a meeting about their own child.
///
/// The TEACHER is the approver — they own the time. A school may opt into
/// leadership approval (School.requireMeetingApproval), and a CONCERN always
/// involves leadership whatever that setting says, because a concern addressed
/// to the person it may be about is the one routing this must not get wrong.
model MeetingRequest {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// Scalar FKs (DB-level), matching the pattern that keeps User lean.
  parentId  String @db.Uuid
  studentId String @db.Uuid
  teacherId String @db.Uuid

  /// PROGRESS | WELLBEING | ATTENDANCE | CONCERN | OTHER
  topic  String
  note   String?
  /// PENDING_APPROVAL | PENDING_TEACHER | ACCEPTED | DECLINED | CANCELLED
  status String @default("PENDING_TEACHER")

  /// Who accepted/declined, and why. A decline without a reason tells the
  /// parent nothing and is the commonest cause of a re-request.
  decidedById  String? @db.Uuid
  decisionNote String?
  /// The slot opened when it was accepted — the meeting itself.
  slotId       String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  /// The teacher's inbox, and the staleness sweep.
  @@index([schoolId, teacherId, status])
  /// The parent's own list.
  @@index([schoolId, parentId, status])
  @@map("meeting_request")
}
