// =============================================================================
// Scholarship — platform-owned, cross-tenant sponsorship
// =============================================================================
// Mirrors the Ultimate arena's two-halves split (spec: a global platform surface
// + a tenant-scoped bridge), so a minor's data only crosses the tenant boundary
// to the platform owner WITH guardian consent.
//   (A) ScholarshipProgram — GLOBAL, platform-owned, RLS-EXEMPT (listed in the
//       RLS file like `school`/`plan_price`). No school_id; super_admin CRUD via
//       the privileged client; the app role has SELECT so every school sees OPEN
//       programs.
//   (B) ScholarshipApplication — TENANT-SCOPED (non-null school_id + standard
//       RLS). A parent/teacher applies for a student in THEIR school; the
//       platform owner reviews across tenants via the operator privileged path.
//       Append-only decisions (no hard-delete). Guardian consent (scalar fields)
//       is required before submission (Golden Rule #5).
// An AWARDED application disburses through the Fees module (PaymentKind.SCHOLARSHIP)
// so the money is integer-kobo, audited, and never hard-deleted like every other
// financial record. // SECURITY (Golden Rule #8): the platform owner DECIDES;
// the collected academic/attendance/fee `signals` inform review, never a verdict.
// =============================================================================

enum ScholarshipProgramStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ScholarshipAwardKind {
  FEES_CREDIT
  SUBSCRIPTION_CREDIT
}

enum ScholarshipSelectionBasis {
  MERIT
  NEED
  BOTH
}

/// Scholarship discipline/category (chosen by the platform owner per program).
enum ScholarshipCategory {
  GENERAL_SCIENCE
  ART
  COMMUNITY_DEVELOPMENT
  MATHEMATICS
  SPECIAL
}

/// How the qualification exam is sat: online CBT mock, the games arena, or a
/// physically scheduled exam.
enum ScholarshipExamMode {
  ONLINE_CBT
  GAMES
  PHYSICAL
}

enum ScholarshipApplicationStatus {
  DRAFT
  /// Student-initiated chain (in order): class supervisor → guardian → principal.
  /// Each stage approves or REJECTS (rejectedStage records where it died).
  PENDING_SUPERVISOR
  PENDING_PARENT
  PENDING_PRINCIPAL
  /// Fully school-approved — in the platform owner's cross-tenant queue.
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  /// Platform-approved: the student is a qualified candidate for the
  /// scholarship exam (category + mode + date live on the program).
  QUALIFIED
  AWARDED
  REJECTED
}

/// (A) GLOBAL program — platform-owned, RLS-EXEMPT.
model ScholarshipProgram {
  id              String                    @id @default(uuid()) @db.Uuid
  title           String
  /// When each SUBJECT's paper opens, for a scholarship examined in more than
  /// one subject: `{ "Mathematics": { "examAt": "...", "durationMin": 45 } }`.
  ///
  /// The subjects themselves are NOT stored here — they are whichever subjects
  /// the questions carry, so a paper can never exist with nothing on it and a
  /// subject can never be silently dropped. This map only STAGGERS them; a
  /// subject with no entry uses the programme's own `examAt` / `examDurationMin`,
  /// which is exactly the single-paper behaviour this replaces.
  examSchedule       Json?

  /// When the platform owner PUBLISHED the results to every school.
  ///
  /// NULL means nobody outside the operator console sees them: a score is a
  /// fact about a child's exam, and it becomes public only when the owner has
  /// reviewed the marking and decided to publish. Once set, every school on the
  /// platform can read the ranked table — SCHOOL, POSITION and SCORE, never the
  /// pupil's name.
  resultsPublishedAt DateTime?
  description     String?
  /// Total budget + per-award amounts, integer minor units (kobo). awardMinor is
  /// the FIRST-position prize; 2nd/3rd fall back to it when null.
  budgetMinor     BigInt                    @default(0)
  awardMinor      Int
  award2Minor     Int?
  award3Minor     Int?
  awardKind       ScholarshipAwardKind      @default(FEES_CREDIT)
  selectionBasis  ScholarshipSelectionBasis @default(BOTH)
  /// Free-form / structured eligibility rules (JSONB) — displayed to applicants.
  eligibility     Json?
  opensAt         DateTime
  closesAt        DateTime
  status          ScholarshipProgramStatus  @default(DRAFT)
  /// Category the owner selects for the program (science/art/community/maths/special).
  category        ScholarshipCategory       @default(SPECIAL)
  /// Qualification exam details — set by the owner once candidates qualify;
  /// announce-exam notifies every QUALIFIED student + their guardians.
  examMode        ScholarshipExamMode?
  examAt          DateTime?
  /// Venue (PHYSICAL) or platform pointer (ONLINE_CBT / GAMES) — display text.
  examVenue       String?
  /// How many candidates ONE school may have QUALIFIED for this programme.
  /// Null = no cap, which is every programme authored before the column
  /// existed. Enforced when an application is QUALIFIED — the point at which
  /// the operator decides who actually sits — not when it is applied for, so a
  /// family is never turned away from applying by another school's numbers.
  /// ISO code the award is paid in. Null = the platform's home currency, which
  /// is what every programme authored before this column used. It must match the
  /// school's own fee currency for the credit to post — a scholarship cannot be
  /// converted, because this platform holds no FX rate and inventing one to
  /// clear a family's fees would be worse than refusing.
  awardCurrency String?
  /// ISO-3166 alpha-2 codes this programme is open to. Null or empty = every
  /// country, which is what every programme authored before this column used.
  /// A LIST so the owner chooses the granularity per programme — one country,
  /// a region, or the whole platform.
  countries String[]
  maxCandidatesPerSchool Int?
  /// ONLINE_CBT sitting length (minutes).
  examDurationMin Int                       @default(30)
  /// ONLINE_CBT question set, owner-authored: [{text, options[], answerIndex}].
  /// SECURITY: answerIndex lives here (platform-owned row, app role SELECT-only)
  /// but is NEVER serialized to applicants — announce materializes real CbtQuestion
  /// rows per school, and the CBT module keeps answers server-only mid-sitting.
  examQuestions   Json?
  /// super_admin userId (scalar audit field; NO cross-tenant user relation).
  createdById     String                    @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("scholarship_program")
  @@index([resultsPublishedAt(sort: Desc)])
}

/// (B) TENANT-SCOPED application — standard RLS on school_id.
model ScholarshipApplication {
  id                    String                       @id @default(uuid()) @db.Uuid
  schoolId              String                       @db.Uuid
  /// Program applied to (DB FK to the global program; no Prisma relation — the
  /// program is RLS-exempt/global and read via the privileged/SELECT path).
  programId             String                       @db.Uuid
  /// Student the application is FOR (DB FK to user; scalar).
  studentId             String                       @db.Uuid
  /// Who applied + their role at apply time (parent | teacher).
  applicantId           String                       @db.Uuid
  applicantRole         String
  /// Application answers (essay, need statement, …) — JSONB.
  answers               Json?
  /// Verified signals snapshot at submission (grades/attendance/fees) — for the
  /// reviewer only; SIGNALS, never a verdict (Golden Rule #8). JSONB.
  signals               Json?
  status                ScholarshipApplicationStatus @default(DRAFT)
  /// Guardian consent to disclose the minor's data to the platform (REQUIRED to
  /// submit). Scalar audit fields — who consented + when. In the student-
  /// initiated chain the PARENT-stage approval IS the consent (one act).
  consentById           String?                      @db.Uuid
  consentAt             DateTime?
  /// Student-initiated approval chain — one scalar record per stage (who/when/
  /// note). Append-only in spirit: set once when the stage decides.
  supervisorById        String?                      @db.Uuid
  supervisorAt          DateTime?
  supervisorNote        String?
  parentNote            String?
  principalById         String?                      @db.Uuid
  principalAt           DateTime?
  principalNote         String?
  /// Where a REJECTED application died: SUPERVISOR | PARENT | PRINCIPAL | PLATFORM.
  rejectedStage         String?
  /// Qualification-exam result pulled back from the bound CBT sitting (score %)
  /// or arena standing (relative %). A SIGNAL for the award decision — the
  /// platform owner still decides (Golden Rule #8).
  examScorePct          Float?
  /// Review outcome (set by the platform owner): the award + who/why.
  /// awardPosition: 1 | 2 | 3 — each position granted once per program.
  awardPosition         Int?
  awardMinor            Int?
  reviewedById          String?                      @db.Uuid
  reviewNote            String?
  /// The Fees Payment posted as the credit when AWARDED (disbursement link).
  disbursementPaymentId String?                      @db.Uuid
  /// The credit-ledger entry, when the award was held as credit because the
  /// pupil had no open invoice at the moment it was decided. Exactly one of
  /// this and `disbursementPaymentId` is set on a disbursed award.
  disbursementCreditEntryId String?                  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  /// One application per student per program.
  @@unique([programId, studentId])
  /// PARTIAL UNIQUE (programId, awardPosition) WHERE status = 'AWARDED' —
  /// created in migration 20261227000000_scholarship_award_position_unique.
  /// Prisma cannot express a partial index, so it lives in SQL only; declared
  /// here so it is not read as missing. It makes "Best Three" structural: at
  /// most three awardees, each at a distinct position, rather than a rule two
  /// concurrent awards could both pass.
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([programId, status])
  @@index([programId, examScorePct(sort: Desc)])
  // The platform owner's review queue: paged ORDER BY createdAt, id. Without
  // this it is a seq scan of every application ever, on every page load.
  //
  // The two filter-leading ones matter for the same reason and are NOT
  // interchangeable with it: with a BOUND parameter Postgres takes a generic
  // plan, and without a filter-leading index it walks this one oldest-first
  // looking for rows that are the newest — 213 ms over 497,011 buffers at a
  // decade of volume. Migration 20270125000000 records every measurement.
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([programId, createdAt, id])
  @@map("scholarship_application")
}

/// A question written ONCE and reused across programmes.
///
/// A programme's paper lives inline on the programme, and that is right: a
/// paper that has been sat must never change under the candidates who sat it.
/// The cost was that nothing survived the programme — a question written for
/// last year's exam had to be typed again this year.
///
/// So this is a LIBRARY that papers are assembled FROM, never a set of
/// references a paper points AT. Copying is the whole semantics.
///
/// SECURITY: platform-owned and DENY-ALL to the app role (rls/50). Every row
/// carries an answer key to a cross-school competition and no tenant context
/// ever needs one — a question reaches a candidate only by being copied into a
/// programme and materialised as a CbtQuestion inside that school's own tenant.
/// A bank of questions for ONE subject, built up and then declared finished.
///
/// The library began as a flat list of questions each carrying a subject. That
/// is enough to REUSE a question and not enough to WORK: an owner writes sixty
/// to a hundred questions for one subject in a sitting and needs somewhere to
/// build, correct and finish them.
///
/// STATUS is what makes it a place rather than a label: a bank being written is
/// DRAFT and cannot be drawn on, so a half-written paper can never reach a
/// candidate.
///
/// SECURITY: platform-owned, DENY-ALL to the app role (rls/50), like the
/// questions it holds.
model ScholarshipQuestionBank {
  id   String @id @default(uuid()) @db.Uuid
  name String
  /// A SUBJECT_CONCEPTS key — the comparability anchor the subject catalogue
  /// already uses, so a bank means the same thing whatever curriculum a school
  /// follows. A scholarship spans schools on several.
  subjectCode String
  /// The display name as at creation. Denormalised on purpose: a catalogue
  /// rename must not silently retitle a bank an owner built.
  subjectName String
  /// DRAFT while it is being written; READY once "Save bank" is pressed.
  status      String @default("DRAFT")
  /// DB FK to user; scalar, no Prisma relation — the documented pattern here.
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions ScholarshipQuestion[]

  @@index([subjectCode, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("scholarship_question_bank")
}

model ScholarshipQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  /// The bank this belongs to. A bank IS its questions, so the FK cascades.
  bankId      String   @db.Uuid
  subject     String
  text        String
  options     String[]
  answerIndex Int
  /// The owner's own note. Never printed on a paper and never sent anywhere.
  note        String?
  /// DB FK to user; scalar, no Prisma relation — the documented pattern here.
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bank ScholarshipQuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId, createdAt])
  @@index([subject, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("scholarship_question")
}
