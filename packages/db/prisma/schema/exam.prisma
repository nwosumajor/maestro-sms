// =============================================================================
// Exam logistics — sittings, seating plans, invigilation
// =============================================================================
// Physical exam administration (distinct from the CBT module): a scheduled
// sitting in a hall, a seat number per student, and an invigilator roster.

/// An exam SCHEDULE — the approvable batch of subject sittings for a term. The
/// whole schedule is approved once (maker-checker: head teacher → principal);
/// on approval every linked CBT exam is published (but not yet OPEN — a per-exam
/// day-of release opens it). Tenant-scoped (RLS).
model ExamSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  title       String
  /// Optional academic term this schedule belongs to (DB link; scalar).
  termId      String?  @db.Uuid
  /// DRAFT | PENDING_REVIEW | APPROVED | REJECTED.
  status      String   @default("DRAFT")
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id])
  sittings ExamSitting[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("exam_schedule")
}

/// A scheduled physical exam sitting in a hall.
model ExamSitting {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  title       String
  subject     String?
  date        DateTime @db.Date
  startsAt    String // "09:00"
  endsAt      String // "11:00"
  /// The hall LABEL as printed on the timetable and the attendance sheet. Kept as
  /// a stored string even when roomId is set, so a past sitting still reads
  /// honestly after a room is renamed or removed.
  hall        String
  /// The room from the school's registry, when the hall was picked rather than
  /// typed. Optional because sittings predate the picker and an ad-hoc venue
  /// (a marquee, a borrowed hall) is legitimate. Having it is what lets capacity
  /// come from the registry instead of being retyped per sitting.
  roomId      String?  @db.Uuid
  capacity    Int      @default(0)
  note        String?
  /// The class sitting this exam. For a CBT-backed sitting the roster is read off
  /// the exam's own classId; a PAPER sitting has no exam, so without this there is
  /// nothing to auto-seat FROM and every paper hall had to be seated by hand.
  classId     String?  @db.Uuid
  /// The schedule this sitting belongs to (grouped for batch approval); null for
  /// a standalone/ad-hoc sitting.
  scheduleId  String?  @db.Uuid
  /// The online CBT exam backing this sitting, if any (DB link; scalar). A sitting
  /// with a cbtExamId lets students sit online; without, it's a paper exam.
  cbtExamId   String?  @db.Uuid
  /// Staff who created it (DB FK to user; audit field).
  createdById String   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  schedule     ExamSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  // SetNull on both: losing a room or a class must never delete exam history, and
  // the sitting stays readable because `hall` carries its own label.
  room         Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  class        Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  seats        ExamSeat[]
  invigilators ExamInvigilator[]

  @@index([schoolId])
  // (schoolId, date) already serves the hall-clash lookup: a clash can only occur
  // on the same day, so the check reads one day's sittings, never a table scan.
  @@index([schoolId, date])
  @@index([schoolId, scheduleId])
  @@map("exam_sitting")
}

/// One student's seat in a sitting.
model ExamSeat {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  sittingId String @db.Uuid
  /// Student (DB FK to user; scalar).
  studentId String @db.Uuid
  seatNo    Int

  createdAt DateTime @default(now())

  school  School      @relation(fields: [schoolId], references: [id])
  sitting ExamSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  @@unique([sittingId, studentId])
  @@unique([sittingId, seatNo])
  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("exam_seat")
}

/// A staff invigilator assigned to a sitting.
model ExamInvigilator {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  sittingId String  @db.Uuid
  /// Staff (DB FK to user; scalar).
  staffId   String  @db.Uuid
  lead      Boolean @default(false)

  createdAt DateTime @default(now())

  school  School      @relation(fields: [schoolId], references: [id])
  sitting ExamSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  @@unique([sittingId, staffId])
  @@index([schoolId])
  @@index([schoolId, staffId])
  @@map("exam_invigilator")
}
