// =============================================================================
// Privacy / NDPR data-subject rights — right-to-erasure requests
// =============================================================================
// Data SUBJECTS (students) and their guardians can request export of, and
// erasure of, a student's personal data. Export is served directly (a JSON
// bundle, audit-logged). Erasure is a governed REQUEST: a data controller
// (school_admin / principal) reviews it against retention obligations before any
// data is removed — erasing a minor's record is never a one-click action. All
// tenant-scoped (non-null schoolId), RLS-enforced.
// =============================================================================

enum ErasureStatus {
  PENDING
  APPROVED
  REJECTED
}

model ErasureRequest {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// The student whose data is requested for erasure (DB FK to user; scalar).
  studentId     String        @db.Uuid
  /// Who raised it (the subject or a guardian; DB FK to user; scalar).
  requestedById String        @db.Uuid
  reason        String
  status        ErasureStatus @default(PENDING)
  /// The controller who reviewed it (DB FK to user; scalar).
  reviewedById  String?       @db.Uuid
  reviewNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("erasure_request")
}

// =============================================================================
// DataBreachIncident — GDPR Art. 33/34, the 72-hour clock
// =============================================================================
// A school under GDPR must notify its supervisory authority within 72 HOURS of
// becoming aware of a personal-data breach (Art. 33), and must tell the affected
// people themselves without undue delay when the risk to them is high (Art. 34).
// A school holding children's data is exactly the case the regulation is written
// for.
//
// The deadline is computed from `discoveredAt` — when the school BECAME AWARE —
// not from when the breach happened or when this row was created. Those are
// different moments and only one of them starts the clock.
//
// Append-mostly: an incident is never deleted, and its discovery time is never
// edited, because the whole value of the record is that it fixes when the clock
// started. Status moves forward; the history stays.
// =============================================================================
model DataBreachIncident {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  title          String
  description    String
  /// When the school BECAME AWARE. Starts the 72-hour clock (Art. 33(1)).
  discoveredAt   DateTime
  /// OPEN | ASSESSED | NOTIFIED | CLOSED.
  status         String   @default("OPEN")
  /// LOW | HIGH. HIGH additionally requires telling the data subjects (Art. 34).
  riskLevel      String   @default("HIGH")
  /// Rough count of people affected — a figure the authority asks for first.
  affectedCount  Int      @default(0)
  /// Free-text categories of data involved (e.g. "names, addresses, medical").
  dataCategories String?

  /// When the supervisory authority was notified (Art. 33).
  notifiedAuthorityAt  DateTime?
  /// When the affected people were told (Art. 34) — required when risk is HIGH.
  notifiedSubjectsAt   DateTime?
  /// Why notification was NOT required, when it was not (Art. 33(1) proviso).
  noNotificationReason String?

  reportedById String    @db.Uuid
  closedAt     DateTime?
  closedById   String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("data_breach_incident")
}

/// A point-in-time archive of the school's whole institutional record for one
/// academic session — the artifact a principal produces so that a question asked
/// in ten years can still be answered.
///
/// WHY THIS EXISTS RATHER THAN "restore a backup": a backup is disaster
/// recovery. Answering one question about one pupil from 2018 by restoring a
/// database is a multi-hour operation needing spare infrastructure, and the
/// off-site archives only reach 365 days. This is a retrieval artifact instead:
/// one object, downloadable through the vault's normal audited path.
///
/// It is also the ONLY thing that survives retention. The telemetry sweeps
/// deliberately delete on a schedule; whatever is not archived is genuinely gone.
///
/// NEVER AUTO-DELETED. A retention rule that removed these would defeat the sole
/// purpose of having them. Removing one is a deliberate, audited act.
model SchoolArchive {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// The academic session archived, and a human label ("2025/2026").
  sessionId    String? @db.Uuid
  /// The TERM archived, when this was produced at a term boundary. Unique per
  /// school, so the scheduled sweep can only ever archive a term ONCE however
  /// many times it runs — the idempotency that makes a daily job safe.
  termId       String? @db.Uuid
  label        String
  /// Object-storage key for the archive body.
  storageKey   String  @unique
  /// SHA-256 of the stored bytes. An archive someone could have edited is worth
  /// little in an investigation, so its integrity is checkable on retrieval.
  checksum     String
  sizeBytes    Int
  /// Row counts per section, so "what is in here" is answerable without
  /// downloading it — and so a suspiciously empty archive is visible.
  sections     Json
  /// CONTAINS DECRYPTED STAFF SALARIES. Recorded explicitly because it governs
  /// who may download it: field encryption uses a key that may be rotated or
  /// gone in ten years, so an archive of ciphertext would be useless — the
  /// figures are decrypted at archive time and the artifact is gated instead.
  containsHrPii Boolean @default(true)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, createdAt])
  /// The scheduler's guard: one archive per term, enforced by the database
  /// rather than by the sweep remembering.
  @@unique([schoolId, termId])
  @@map("school_archive")
}
