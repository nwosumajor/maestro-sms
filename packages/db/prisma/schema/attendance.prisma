// =============================================================================
// Attendance — per-class, per-day attendance for enrolled students
// =============================================================================
// A teacher of a class takes attendance for a date: one AttendanceSession per
// (class, date), with one AttendanceRecord per enrolled student. Parents see
// their child's records; students see their own; school staff see all. All
// tenant-scoped (non-null schoolId), RLS-enforced; relationship scoping
// (teacher-of-class / parent-of-child / self / school staff) lives in
// AttendanceService — same model as LMS/SIS. Mutations are audit-logged.
//
// Records are CORRECTED, not deleted (an absence wrongly marked is updated, with
// the change audited) — so there is no delete path. Status is a fact recorded by
// a human, never an automated judgement (Golden Rule #8).
// =============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One attendance "register" for a class on a given day.
model AttendanceSession {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  classId   String   @db.Uuid
  /// The school day this register is for (DATE, no time).
  date      DateTime @db.Date
  /// FK -> User(id) of the staff member who took it.
  takenById String   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School @relation(fields: [schoolId], references: [id])
  class   Class  @relation(fields: [classId], references: [id])
  takenBy User   @relation("AttendanceTakenBy", fields: [takenById], references: [id])

  records AttendanceRecord[]

  /// One register per class per day.
  @@unique([classId, date])
  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([schoolId, date])
  @@map("attendance_session")
}

/// Per-term attendance totals, precomputed. One row per (term, class, student).
///
/// WHY THIS IS SAFE, which is the whole design: a term that has ENDED is immutable.
/// AttendanceService refuses every write to a register dated before the current
/// term's start — locked for everyone, including leadership, with no approval path.
/// So a rollup of an ended term can never drift from the records it summarises.
/// Only ENDED terms are ever stored here; the current term is always computed live,
/// so today's figure is never stale. That is why there is no staleness field and no
/// "refresh before reading" dance.
///
/// Grain is (term, class, student) rather than a school total, because the same rows
/// then answer three questions — the school's term attendance, a class's, and a
/// pupil's — and it stays small: 3,000 pupils x 3 terms is ~9,000 rows a year, versus
/// the ~540,000 raw records those terms contain.
model AttendanceTermRollup {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  termId    String @db.Uuid
  classId   String @db.Uuid
  /// Student (DB FK to user; scalar, keeping the User model lean).
  studentId String @db.Uuid

  present Int @default(0)
  absent  Int @default(0)
  late    Int @default(0)
  excused Int @default(0)
  /// Registers this pupil appears in for the term (the denominator).
  total   Int @default(0)

  /// When this row was computed. Informational — an ended term cannot change, so
  /// this is provenance, not a cache-invalidation signal.
  computedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// One row per pupil per class per term — the upsert key, so a recompute
  /// replaces rather than duplicates.
  @@unique([termId, classId, studentId])
  @@index([schoolId])
  @@index([schoolId, termId])
  @@index([schoolId, termId, classId])
  @@map("attendance_term_rollup")
}

/// One student's status within a session.
model AttendanceRecord {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @db.Uuid
  sessionId String @db.Uuid
  /// FK -> User(id) of the student.
  studentId String @db.Uuid

  status AttendanceStatus
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School            @relation(fields: [schoolId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [id])
  student User              @relation("AttendanceStudent", fields: [studentId], references: [id])

  /// One record per student per session.
  @@unique([sessionId, studentId])
  @@index([schoolId])
  @@index([schoolId, sessionId])
  @@index([schoolId, studentId])
  @@map("attendance_record")
}
