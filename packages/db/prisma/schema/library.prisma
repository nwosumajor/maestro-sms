// =============================================================================
// Library Management — tenant-scoped (school_id non-null + RLS). Book catalogue
// (barcode-keyed) + loans (issue / renew / return with overdue fines). Students
// search + self-issue from their dashboard; the librarian manages the catalogue,
// runs issued/due reports, exports CSV, and records fine receipts.
// =============================================================================

model LibraryBook {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  title           String
  author          String?
  isbn            String?
  /// Barcode label (scanned to issue/return). Unique within a school.
  barcode         String
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  customFields    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans BookLoan[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, barcode])
  @@index([schoolId])
  @@map("library_book")
}

model BookLoan {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @db.Uuid
  bookId       String    @db.Uuid
  /// Borrower (a student or staff User).
  borrowerId   String    @db.Uuid
  /// ISSUED | RETURNED
  status       String    @default("ISSUED")
  issuedAt     DateTime  @default(now())
  dueAt        DateTime
  returnedAt   DateTime?
  renewedCount Int       @default(0)
  /// Days this loan was ALREADY late at the moment it was renewed.
  ///
  /// The fine is computed at return from `dueAt`, and a renewal moves `dueAt`
  /// forward — so without this the days already late simply stopped existing,
  /// and a borrower could clear their own fine by renewing (they hold
  /// `library.borrow` and may renew their own loan). Carried, not recomputed.
  lateDaysCarried Int    @default(0)
  /// Overdue fine accrued on return, in MINOR units. finePaid records the receipt.
  fineMinor    Int       @default(0)
  finePaid     Boolean   @default(false)
  /// WHEN the fine was paid. `finePaid` recorded that money changed hands and
  /// not when, so the receipt's date was invented at print time and the school
  /// had no record of the date at all — only the audit entry.
  finePaidAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  book LibraryBook @relation(fields: [bookId], references: [id])

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, borrowerId])
  @@index([bookId, status])
  @@map("book_loan")
}
