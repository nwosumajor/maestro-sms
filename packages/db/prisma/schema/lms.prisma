// =============================================================================
// LMS core — Classes, Enrollment, Teaching assignments, Guardian links
// =============================================================================
// The keystone for relationship-scoping (RBAC beyond role, per CLAUDE.md):
//   - a teacher sees only THEIR classes      (Class.supervisorId + ClassSubjectTeacher)
//   - a student sees only THEIR classes      (Enrollment)
//   - a parent sees only THEIR children      (ParentChild) and their classes
// All tenant-scoped (non-null schoolId, RLS-enforced). These are MEMBERSHIP
// tables; the relationship checks live in the service layer on top of RLS.
// =============================================================================

/// A class/section within a school (e.g. "History 101"). Assessments belong to
/// a class, which is how integrity reports become teacher-of-class scoped.
model Class {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  name         String
  /// Short stable code (e.g. JSS2A). Auto-generated from the name when left
  /// blank; unique per school so rosters and CSV imports key on it.
  code         String   @default(dbgenerated("left(replace(gen_random_uuid()::text, '-', ''), 8)"))
  /// Ordering within the school's progression (e.g. JSS1=1, JSS2=2). Drives the
  /// "promote to the next class" flow together with nextClassId.
  level        Int?
  /// The year group this class belongs to: PRE_PRIMARY | PRIMARY |
  /// JUNIOR_SECONDARY | SENIOR_SECONDARY (the SUBJECT_STAGES vocabulary the
  /// subject catalogue already uses — one word for a year group across the
  /// product). Null = ungrouped; such a class is never swept up by a year-group
  /// meeting, which is the safe direction.
  stage        String?
  /// The class students promote INTO at end of session. Null = final/terminal
  /// class (promotion graduates instead of moving). Self-relation within a school.
  nextClassId  String?  @db.Uuid
  /// A staff member who supervises this class (form teacher). Gains roster READ
  /// access to the class even if not a subject teacher. Optional.
  supervisorId String?  @db.Uuid
  /// Max ACTIVE enrollments; enrollment/import/promotion refuse to exceed it. Null
  /// = unlimited.
  capacity     Int?
  /// SCIENCE | ART | COMMERCIAL | GENERAL — the senior-school stream this class
  /// belongs to. Null for junior/primary classes, and for any class created
  /// before streams existed. Chosen from a fixed list, never typed.
  stream       String?
  /// "A".."J" when a stream is split across several rooms. Null when the stream
  /// is one class. Also chosen, never typed — a free-text arm produces "A",
  /// "a", "A " and "1" as four arms of one stream.
  arm          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school             School                @relation(fields: [schoolId], references: [id])
  enrollments        Enrollment[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  lmsContents        LmsContent[]
  subjectTeachers    ClassSubjectTeacher[]
  examSittings       ExamSitting[]

  nextClass         Class?                 @relation("ClassProgression", fields: [nextClassId], references: [id])
  previousClasses   Class[]                @relation("ClassProgression")
  supervisor        User?                  @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  promotionsFrom    PromotionBatch[]       @relation("PromotionSource")
  promotionsTo      PromotionBatch[]       @relation("PromotionTarget")
  attendanceRollups AttendanceTermRollup[]

  // Identity integrity: no two classes in a school share a name or code, so a
  // student or teacher can never be assigned to an ambiguous class.
  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, supervisorId])
  /// Grouping a year's streams and arms — "every SS3 Science class" — is the
  /// query behind stream ranking, the subject-set copy and a stream-wide
  /// announcement. Without this it is a seq scan of every class in the school.
  @@index([schoolId, stage, level, stream])
  @@map("class")
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A staged end-of-session promotion of a class's students into its next class.
/// Maker-checker: an initiator stages the batch (nothing moves); school_admin
/// approves, which moves each student's enrollment (source -> PROMOTED, a new
/// ACTIVE enrollment in the target, or GRADUATED for a final class). initiated/
/// reviewed ids are audit-style scalars. Tenant-scoped.
model PromotionBatch {
  id            String          @id @default(uuid()) @db.Uuid
  schoolId      String          @db.Uuid
  sourceClassId String          @db.Uuid
  /// Null = final class: approving GRADUATES the students instead of moving them.
  targetClassId String?         @db.Uuid
  /// Student user ids included in this promotion (snapshot at stage time).
  studentIds    Json
  /// Per-student outcomes: [{studentId, outcome: PROMOTE|RETAIN|DEMOTE,
  /// targetClassId?, note?}]. Null/absent = legacy batch (every student in
  /// `studentIds` is promoted to `targetClassId`). A poor performer is RETAINed
  /// in the present class or DEMOTEd into an explicitly chosen lower class —
  /// always a human decision recorded here, never computed (Golden Rule #8).
  decisions     Json?
  status        PromotionStatus @default(PENDING)
  /// The academic term this promotion runs at the end of (e.g. third term). Scalar
  /// ref to term(id); the DB FK is added in the migration. Optional.
  termId        String?         @db.Uuid
  initiatedById String          @db.Uuid
  reviewedById  String?         @db.Uuid
  reviewNote    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  school      School @relation(fields: [schoolId], references: [id])
  sourceClass Class  @relation("PromotionSource", fields: [sourceClassId], references: [id])
  targetClass Class? @relation("PromotionTarget", fields: [targetClassId], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("promotion_batch")
}

/// A subject in the school's catalog (e.g. "Mathematics"). Reusable across
/// classes; offered to a class via ClassSubjectTeacher. Tenant-scoped.
model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  /// Short stable code (e.g. MTH, ENG). Auto-generated from the name when left
  /// blank; unique per school so imports and pickers key on it, not free text.
  code      String   @default(dbgenerated("left(replace(gen_random_uuid()::text, '-', ''), 8)"))
  /// The CONCEPT this subject is, when it came from the catalogue (MTH, PHY…).
  /// Null for a custom subject a school typed itself — a first-class state, not
  /// a gap. It is what makes a Senegalese "Mathématiques" and a Nigerian
  /// "Mathematics" comparable while each school stays free to rename its own row.
  catalogueCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School                @relation(fields: [schoolId], references: [id])
  classSubjects    ClassSubjectTeacher[]
  timetableEntries TimetableEntry[]

  // Identity integrity: a school cannot hold two subjects of the same name or
  // code, so teacher/class assignments can never split across duplicate rows.
  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subject")
}

/// A class's offering of a subject, taught by one assigned teacher. One teacher
/// per (class, subject). Tenant-scoped.
model ClassSubjectTeacher {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  classId         String   @db.Uuid
  subjectId       String   @db.Uuid
  teacherId       String   @db.Uuid
  /// CSP timetable-generation quota: lessons per week this offering receives.
  lessonsPerWeek  Int      @default(2)
  /// Fixed room this offering must be taught in (e.g. Chemistry -> Science Lab);
  /// the CSP solver treats it as a hard no-double-booking constraint. Scalar
  /// uuid with a DB-level FK to room (no Prisma relation — keeps models lean).
  preferredRoomId String?  @db.Uuid
  createdAt       DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation("SubjectTeaching", fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([schoolId, teacherId])
  @@map("class_subject_teacher")
}

/// Teaching assignment: which teachers teach a class. Drives "teacher sees only
/// their classes".
/// Student enrollment in a class. Drives "student sees only their classes" and
/// (via ParentChild) "parent sees only their children's classes".
model Enrollment {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  classId      String   @db.Uuid
  studentId    String   @db.Uuid
  /// ACTIVE | PROMOTED | GRADUATED | TRANSFERRED | WITHDRAWN.
  status       String   @default("ACTIVE")
  /// Reason captured on a transfer/withdrawal (lifecycle audit context).
  statusReason String?
  enrolledAt   DateTime @default(now())

  school  School @relation(fields: [schoolId], references: [id])
  class   Class  @relation(fields: [classId], references: [id])
  student User   @relation("StudentEnrollments", fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("enrollment")
}

/// Guardian link: a parent/guardian to a student. Drives "parent sees only their
/// own children". // SECURITY: every parent-facing query joins through this.
model ParentChild {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  parentId     String   @db.Uuid
  studentId    String   @db.Uuid
  relationship String?
  createdAt    DateTime @default(now())

  school  School @relation(fields: [schoolId], references: [id])
  parent  User   @relation("ParentLinks", fields: [parentId], references: [id])
  student User   @relation("ChildLinks", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([schoolId, parentId])
  @@map("parent_child")
}

/// The scheme of work a subject teacher plans and works to for one term.
///
/// LmsContent holds individual items — a material, a quiz, a forum thread — but
/// nothing said what the TERM is meant to cover, so nobody could answer "are we
/// on schedule" without reading every item and remembering the plan. This is
/// that plan: one per (class, subject, term), owned by whoever teaches it.
model SubjectSyllabus {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @db.Uuid
  classId   String @db.Uuid
  subjectId String @db.Uuid
  termId    String @db.Uuid
  /// Free-text aims for the term, above the week-by-week breakdown.
  overview  String?
  /// The teacher who owns this plan. Scalar uuid + DB FK, no Prisma relation.
  ownerId   String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School            @relation(fields: [schoolId], references: [id])
  items  SubjectSyllabusItem[]

  /// One plan per subject per class per term — two would make "the plan"
  /// ambiguous, and every progress figure below it arbitrary.
  @@unique([classId, subjectId, termId])
  @@index([schoolId])
  @@index([schoolId, subjectId])
  @@map("subject_syllabus")
}

/// One week (or unit) of the plan.
model SubjectSyllabusItem {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @db.Uuid
  syllabusId String @db.Uuid
  /// Ordering. Week 1..n; duplicates are allowed because a topic can span weeks.
  week       Int
  topic      String
  objectives String?
  resources  String?
  /// PLANNED | TAUGHT — the flag that makes this a living document rather than
  /// a file, and the only thing that makes "on schedule" answerable.
  status     String   @default("PLANNED")
  taughtAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id])
  syllabus SubjectSyllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([syllabusId])
  @@map("subject_syllabus_item")
}
