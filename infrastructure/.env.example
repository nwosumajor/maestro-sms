# Copy to .env (compose reads it). CHANGE ALL SECRETS for anything real.

# Postgres superuser (migration/admin role).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=sms

# Password for the least-privilege app role `major_user` (created on first DB init).
APP_DB_PASSWORD=change-me-app

# PRIVILEGED background jobs: the NDPR integrity purge, billing dunning, HR document
# reminders, the SIS profile nudge, and operator/cross-tenant reads. These span
# tenants by design, so they cannot use the RLS-scoped app role.
#
# Compose defaults this to the superuser, so the local stack works unset. SET IT
# EXPLICITLY in any real deployment — ideally to a role narrower than the migration
# superuser (it needs SELECT/UPDATE/DELETE on telemetry + subscription tables, never
# DDL). Leave it EMPTY and every one of those jobs silently no-ops: they fail closed,
# so the only symptom is "reminders stopped arriving" with nothing in the logs.
DATABASE_RETENTION_URL=postgresql://postgres:change-me-superuser@postgres:5432/sms

# Shared secret: the API verifies the Auth.js JWT signed with this. Web + API must match.
AUTH_SECRET=change-me-32-char-min-secret

# Seed demo data (school + users + a class) on first backend start. Dev only.
SEED_ON_START=true
# LOCAL ONLY — seeds the demo school and the @demo.school logins (password123).
# Never set this in a cloud/production environment.
SEED_DEMO_DATA=true

# Field-level PII encryption key (32 bytes, base64). Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=Q5gcF3Ehy9TDmCWdhBIcu3BMCdoapo/z6xroVbv6zoE=

# --- payment rails -----------------------------------------------------------
# TEST credentials only. `infrastructure/.env` is gitignored; this example file
# is NOT, so never paste a real key here.
#
# Paystack is the platform's live rail (the others are switched off in the
# operator's payment switchboard). Without a key the switchboard reports
# "switched on but NOT usable" — deliberately, so a missing key is visible to
# the operator rather than to a parent at checkout.
#
# Get a test key: dashboard.paystack.com → Settings → API Keys & Webhooks →
# "Test Secret Key" (starts sk_test_). Then prove it end to end with
# "Test connection" on /operator/pricing — a present key is not a working one.
PAYSTACK_SECRET_KEY=
# Optional. Which bank issues a pupil's dedicated NUBAN. Defaults to wema-bank.
PAYSTACK_DEDICATED_BANK=

# Only needed if you switch the Stripe channel on (USD). While it is off, USD
# invoices route to Paystack, which settles USD too.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
